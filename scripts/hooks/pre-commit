#!/usr/bin/env bash
# Installed with: git config core.hooksPath scripts/hooks
set -e
cd "$(git rev-parse --show-toplevel)"
python3 scripts/secret_scan.py
if [ -x .venv/bin/python ]; then
  .venv/bin/python -m pytest -q --no-header -p no:cacheprovider >/dev/null || { echo "pre-commit: tests failing, commit blocked (run: .venv/bin/python -m pytest)"; exit 1; }
fi
