# Copy to .env and fill in. .env is gitignored; never commit real values.

# Notion internal integration secret (Notion → Settings → Connections → Develop or manage integrations).
# Then open the Content Engine page → ••• → Connections → add the integration.
NOTION_TOKEN=

# Optional: path to the claude CLI if it isn't on PATH (dev box: the VS Code extension's bundled binary).
CLAUDE_BIN=
# Servers only: long-lived token from `claude setup-token` (uses your Claude subscription, not the API).
CLAUDE_CODE_OAUTH_TOKEN=

# P3: free YouTube Data API v3 key (Google Cloud console → APIs → YouTube Data API v3 → Credentials).
YOUTUBE_API_KEY=

# Servers only: exported cookies.txt for Instagram/TikTok (desktop uses the browser login instead).
ENGINE_COOKIES_FILE=
ENGINE_BROWSER=firefox
ENGINE_WHISPER_MODEL=small

# Optional notifications: turn on with Engine Settings "Notifications" = On (or notify.enabled in config).
# notify.channel in config/settings.toml picks telegram or email. Test: cli.py notify-test --apply
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
